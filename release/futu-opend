#!/usr/bin/env bash

set -Eeuo pipefail
set +x
umask 077

bundle_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly bundle_dir
readonly env_file=${FUTU_ENV_FILE:-$bundle_dir/.env}
readonly compose_file=$bundle_dir/compose.yaml
readonly integration_compose_file=$bundle_dir/compose.integration.yaml
readonly release_host_platform=@@FUTU_RELEASE_HOST_PLATFORM@@
compose_files=(-f "$compose_file")

# shellcheck source=script/container-engine.sh
source "$bundle_dir/container-engine.sh"

die() {
  printf 'ERROR: %s\n' "$1" >&2
  exit "${2:-1}"
}

usage() {
  cat <<EOF
Usage: $0 {init|reauth|start|stop|status|logs}
       $0 {-h|--help}

Commands:
  init      Perform the first interactive login
  reauth    Reauthenticate interactively
  start     Start Futu OpenD in the background
  stop      Stop Futu OpenD without removing its data volume
  status    Show the service status
  logs      Follow the Futu OpenD logs

Options:
  -h, --help  Show this help message and exit
EOF
}

file_mode() {
  if stat -c '%a' "$1" >/dev/null 2>&1; then
    stat -c '%a' "$1"
  else
    stat -f '%Lp' "$1"
  fi
}

read_env_value() {
  awk -F= -v wanted="$1" '
    $1 == wanted { value = substr($0, index($0, "=") + 1) }
    END { print value }
  ' "$env_file"
}

unquote_env_value() {
  local value=$1
  if [[ $value == \"*\" && $value == *\" ]]; then
    value=${value:1:${#value}-2}
  elif [[ $value == \'*\' && $value == *\' ]]; then
    value=${value:1:${#value}-2}
  fi
  printf '%s' "$value"
}

require_base() {
  local engine_os host_arch host_os shared_network
  host_os=$(uname -s)
  host_arch=$(uname -m)
  case "$release_host_platform" in
  linux-amd64)
    [[ $host_os == Linux && $host_arch == x86_64 ]] ||
      die 'this release requires a Linux/amd64 host; download the matching host package' 69
    ;;
  macos-apple-silicon)
    [[ $host_os == Darwin && $host_arch == arm64 ]] ||
      die 'this release requires an Apple Silicon Mac; download the matching host package' 69
    ;;
  *)
    die 'release host metadata is invalid' 70
    ;;
  esac
  resolve_container_engine || exit $?
  if [[ $release_host_platform == macos-apple-silicon && $container_engine == podman ]]; then
    die 'the Apple Silicon release requires Docker Desktop; Podman is supported by the Linux/amd64 release' 69
  fi
  engine_os=$(container_engine_os 2>/dev/null) ||
    die "$container_engine engine is not running or is not accessible" 69
  [[ $engine_os == linux || $engine_os == Linux ]] ||
    die "$container_engine must use a Linux container engine" 69
  [[ -f $env_file && ! -L $env_file ]] ||
    die "environment file must be a regular file: $env_file" 66
  [[ $(file_mode "$env_file") == 600 ]] || chmod 0600 "$env_file" ||
    die 'unable to restrict the environment file to mode 0600' 77
  shared_network=${FUTU_SHARED_NETWORK:-$(read_env_value FUTU_SHARED_NETWORK)}
  shared_network=$(unquote_env_value "${shared_network%$'\r'}")
  [[ $shared_network != *$'\n'* && $shared_network != *$'\r'* ]] ||
    die 'FUTU_SHARED_NETWORK must not contain line breaks' 64
  compose_files=(-f "$compose_file")
  if [[ -n $shared_network ]]; then
    [[ -f $integration_compose_file ]] ||
      die "integration Compose file not found: $integration_compose_file" 66
    export FUTU_SHARED_NETWORK=$shared_network
    compose_files+=(-f "$integration_compose_file")
  fi
}

compose() {
  "${compose_cmd[@]}" --env-file "$env_file" "${compose_files[@]}" "$@"
}

validate_config() {
  validate_compose_config "${compose_cmd[@]}" --env-file "$env_file" \
    "${compose_files[@]}"
}

prepare_runtime_key() {
  local key=$1
  LOCAL_RSA_FILE_PATH="$key" compose run --rm --no-deps futu-key-init
}

key_path() {
  local configured
  configured=$(read_env_value LOCAL_RSA_FILE_PATH)
  configured=$(unquote_env_value "${configured:-./futu.pem}")
  [[ $configured != *$'\n'* && $configured != *$'\r'* ]] ||
    die 'LOCAL_RSA_FILE_PATH must not contain line breaks' 64
  if [[ $configured == /* ]]; then
    printf '%s' "$configured"
  else
    printf '%s/%s' "$bundle_dir" "${configured#./}"
  fi
}

ensure_key() {
  local path parent temporary
  path=$(key_path)
  if [[ -e $path || -L $path ]]; then
    [[ -f $path && ! -L $path ]] || die 'RSA key must be a regular file'
    [[ $(file_mode "$path") == 600 ]] ||
      die 'existing RSA key must use mode 0600; it was not modified'
    return
  fi
  command -v openssl >/dev/null 2>&1 || die 'openssl is required' 69
  parent=${path%/*}
  [[ -d $parent && -w $parent ]] || die 'RSA key parent must exist and be writable'
  temporary=$(mktemp "$parent/.futu-key.XXXXXX")
  trap 'rm -f -- "$temporary"' EXIT HUP INT TERM
  if ! openssl genrsa -traditional -out "$temporary" 1024 >/dev/null 2>&1; then
    # macOS LibreSSL emits traditional PKCS#1 by default but does not recognize
    # OpenSSL 3's explicit -traditional option.
    openssl genrsa -out "$temporary" 1024 >/dev/null 2>&1 ||
      die 'OpenSSL could not generate the RSA key'
  fi
  grep -Fqx -- '-----BEGIN RSA PRIVATE KEY-----' "$temporary" ||
    die 'OpenSSL did not generate an unencrypted PKCS#1 RSA key'
  chmod 0600 "$temporary"
  [[ ! -e $path && ! -L $path ]] || die 'RSA key appeared during generation'
  mv -- "$temporary" "$path"
  trap - EXIT HUP INT TERM
  printf 'Generated RSA key: %s\n' "$path"
}

initialize() {
  local account password tty_state status key
  [[ -t 0 && -t 1 ]] || die 'initialization requires a private terminal' 64
  command -v expect >/dev/null 2>&1 || die 'expect is required' 69
  ensure_key
  key=$(key_path)
  LOCAL_RSA_FILE_PATH="$key" validate_config
  LOCAL_RSA_FILE_PATH="$key" compose down
  prepare_runtime_key "$key"

  account=${FUTU_ACCOUNT_ID:-$(read_env_value FUTU_ACCOUNT_ID)}
  password=${FUTU_LOGIN_PASSWORD:-$(read_env_value FUTU_LOGIN_PASSWORD)}
  unset FUTU_LOGIN_PASSWORD
  account=$(unquote_env_value "${account%$'\r'}")
  password=$(unquote_env_value "${password%$'\r'}")
  [[ -n $account && $account != *$'\n'* && $account != *$'\r'* ]] ||
    die 'FUTU_ACCOUNT_ID must be configured' 64
  [[ $password != *$'\n'* && $password != *$'\r'* ]] ||
    die 'FUTU_LOGIN_PASSWORD must not contain line breaks' 64

  tty_state=$(stty -g) || die 'unable to read terminal settings' 74
  restore_tty() { stty "$tty_state" 2>/dev/null || true; }
  trap restore_tty EXIT
  trap 'restore_tty; trap - EXIT; exit 130' HUP INT TERM
  stty -echo || die 'unable to disable terminal echo' 74
  set +e
  FUTU_EXPECT_ACCOUNT="$account" FUTU_EXPECT_PASSWORD="$password" \
    expect "$bundle_dir/interactive-login.exp" \
    env LOCAL_RSA_FILE_PATH="$key" \
    "${compose_cmd[@]}" --env-file "$env_file" "${compose_files[@]}" \
    run --rm --no-deps --interactive --service-ports \
    -e FUTU_LOGIN_MODE=interactive futu-opend
  status=$?
  set -e
  password=''
  unset password
  restore_tty
  trap - EXIT HUP INT TERM
  ((status == 0)) || die "interactive OpenD exited with status $status" "$status"
}

command_name=${1:-}
case "$command_name" in
-h | --help)
  usage
  ;;
init | reauth)
  require_base
  initialize
  ;;
start)
  require_base
  ensure_key
  selected_key=$(key_path)
  LOCAL_RSA_FILE_PATH="$selected_key" validate_config
  prepare_runtime_key "$selected_key"
  LOCAL_RSA_FILE_PATH="$selected_key" compose up -d --no-deps futu-opend
  ;;
stop)
  require_base
  LOCAL_RSA_FILE_PATH="$(key_path)" compose down
  ;;
status)
  require_base
  LOCAL_RSA_FILE_PATH="$(key_path)" compose ps
  ;;
logs)
  require_base
  LOCAL_RSA_FILE_PATH="$(key_path)" compose logs -f futu-opend
  ;;
*)
  usage >&2
  exit 64
  ;;
esac
