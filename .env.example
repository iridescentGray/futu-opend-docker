# Wrapper mode (not an OpenD-native environment variable).
FUTU_LOGIN_MODE=remember

# Required for remember mode. Use the phone number here for phone login.
FUTU_ACCOUNT_ID=
# Phone login only; official examples use a separate value such as +86.
FUTU_ACCOUNT_AREA_CODE=+86

# Default bridge mode: listen on the container interface. The host publication
# is independently fixed to 127.0.0.1 by docker-compose.yaml.
FUTU_OPEND_IP=0.0.0.0
# Standalone host-network file uses this loopback address instead.
FUTU_OPEND_HOST_IP=127.0.0.1
FUTU_OPEND_PORT=11111
# Optional listeners: unset and explicitly empty both mean disabled.
FUTU_OPEND_TELNET_IP=127.0.0.1
FUTU_OPEND_TELNET_PORT=
FUTU_OPEND_WEBSOCKET_PORT=
FUTU_OPEND_WEBSOCKET_IP=127.0.0.1

FUTU_OPEND_RSA_FILE_PATH=/.futu/futu.pem
LOCAL_RSA_FILE_PATH=./futu.pem

# Mirrors stableVersion in opend_version.json. Update both when bumping.
FUTU_OPEND_VER=10.10.7008
# Required for every build. On first initialization, the wrapper downloads a
# temporary official-HTTPS copy, validates it, and records the TOFU digest here.
# Repository CI still requires the same reviewed value in opend_version.json.
FUTU_OPEND_SHA256=
